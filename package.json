{
  "name": "entra-mcp",
  "version": "0.3.1",
  "description": "MCP server for ENTRA \u2014 the agent-ready job platform. Candidates: search, match and rank thousands of verified AI & tech jobs aggregated straight from company ATSs (OpenAI, Anthropic, Stripe, SpaceX\u2026), salary stats, companies hiring, human-in-the-loop apply links. Employers (API key): post jobs, manage listings, read applications, search and match candidates.",
  "type": "module",
  "bin": {
    "entra-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "selftest": "node dist/index.js --selftest",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "smoke:employer": "node scripts/smoke-employer.mjs",
    "test": "npm run selftest && npm run smoke && npm run smoke:employer"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "hiring",
    "ai",
    "claude",
    "agents",
    "careers",
    "ats",
    "recruiting",
    "entra",
    "employer",
    "job-posting",
    "candidates",
    "api-key"
  ],
  "author": "ENTRA (https://entracareers.com)",
  "license": "MIT",
  "homepage": "https://entracareers.com/ai-agents",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dubaikseniia-wq/entra-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dubaikseniia-wq/entra-mcp/issues"
  },
  "mcpName": "io.github.dubaikseniia-wq/entra-mcp"
}
